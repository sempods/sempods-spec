@prefix sps:     <https://schema.sempods.org/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix sd:     <http://www.w3.org/ns/sparql-service-description#> .
@prefix schema:  <https://schema.org/> .

#
# The sempods vocabulary.
#
# It holds only terms that are specific to sempods and have no established equivalent
# elsewhere. Everything a standard vocabulary already says is taken from that vocabulary
# instead — see the note on schema:text and schema:position below, which are deliberately
# reused rather than duplicated here.
#
# Stability guarantees, the deprecation policy and how a term gets added:
# https://github.com/sempods/sempods-spec/blob/main/vocabulary/README.md
#

<https://schema.sempods.org/>
  a                              owl:Ontology ;
  dcterms:title                  "The sempods vocabulary"@en ;
  dcterms:description            """Terms specific to sempods: Context registry state, request-relative Context access summaries,
    SPARQL query features a service can refuse, and optional metadata about `find` hits.
    Deliberately small — the model is expressed in RDF, SPARQL, SHACL and schema.org, not in a
    vocabulary of its own."""@en ;
  vann:preferredNamespacePrefix  "sps" ;
  vann:preferredNamespaceUri     "https://schema.sempods.org/" ;
  dcterms:hasVersion             "0.3.0" ;
  dcterms:issued                 "2026-08-12"^^xsd:date ;
  dcterms:modified               "2026-11-03"^^xsd:date ;
  dcterms:license                <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:publisher              <https://sempods.org/> ;
  rdfs:seeAlso                   <https://sempods.org/> .


##
## find — the semantic entry to the graph
##
## `find` answers with a context-sandboxed subgraph: the matching resources, each expanded with
## its authoritative type and label. That answer is FLAT — no ordering, no score, and no marker
## separating a hit from its expansion (SPS-FIND-018).
##
## The terms below describe a per-hit metadata node for a response that would carry one. They are
## RESERVED, not present: no implementation emits them, and SPS-FIND-022 confines them to a
## representation a client explicitly asks for — which this version of the specification does not
## define. They are published so that the first implementation wanting per-hit metadata adopts
## these names rather than minting its own, and a second one different names again.
##
## Where such a node is emitted, it is transient: it belongs to the response, not to the store, and
## carries no named graph (SPS-FIND-024).
##

sps:FindResult
  a               rdfs:Class, owl:Class ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label      "Find result"@en ;
  rdfs:comment    """Metadata about one hit in a `find` response: which engine produced it,
    where it ranked, and the excerpt that matched. RESERVED — no implementation emits this today,
    and the default `find` answer carries no such node. Where one is emitted, an instance is
    produced per response and is not part of the stored graph: a client may use it for ordering and
    display, and must not expect to retrieve it again.

    Authoritative facts about the hit itself (rdf:type, labels, timestamps) are never asserted
    here. They come from the store during expansion, because the store is what knows them."""@en .


sps:findResult
  a                rdf:Property, owl:ObjectProperty ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label       "find result"@en ;
  rdfs:comment     """Links a resource that matched a `find` query to the metadata node
    describing that match.

    No domain is stated on purpose: any resource can be a hit, and constraining the domain
    would say something about the resource that the search has no standing to say."""@en ;
  rdfs:range       sps:FindResult .


sps:engine
  a                rdf:Property, owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label       "engine"@en ;
  rdfs:comment     """The name of the search engine that produced this result — provenance,
    for a `find` implementation that merges several engines behind one contract. An opaque
    short token, for example "sparql-text" or "ai-search"; the set is open, because which
    engines run is a deployment decision."""@en ;
  rdfs:domain      sps:FindResult ;
  rdfs:range       xsd:string .


##
## Reused, not redefined
##
## An `sps:FindResult` node also carries, where the engine supplies them:
##
##   schema:text      the excerpt that matched — the snippet
##   schema:position  the hit's rank within this response, 1-based
##
## Both are schema.org terms used with their ordinary meaning. They are named here for the
## reader's benefit and deliberately not given a domain or range in this file: constraining a
## foreign term inside one's own vocabulary is exactly the redefinition NAMESPACE.md asks third
## parties not to do, and the rule holds for this project too.
##

## Context registry response vocabulary

sps:public
  a rdf:Property, owl:DatatypeProperty ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "public"@en ;
  rdfs:domain sd:NamedGraph ;
  rdfs:range xsd:boolean ;
  rdfs:comment "The Context registry's public-read setting. This value describes registry state; an ordinary data assertion using this predicate changes no access policy."@en .

sps:readableContext
  a rdf:Property, owl:ObjectProperty ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "readable Context"@en ;
  rdfs:domain sd:GraphCollection ;
  rdfs:range sd:NamedGraph ;
  rdfs:comment "Links a registry catalogue to a Context for which the requesting client has effective read permission under the applicable Context contract. This is a response-relative summary, not a stored policy or a transferable capability. Later operations require current authorization."@en .

sps:writableContext
  a rdf:Property, owl:ObjectProperty ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "writable Context"@en ;
  rdfs:domain sd:GraphCollection ;
  rdfs:range sd:NamedGraph ;
  rdfs:comment "Links a registry catalogue to a Context for which the requesting client has effective write permission under the applicable Context contract. This is a response-relative summary, not a stored policy or a transferable capability. Later operations require current authorization."@en .

sps:manageableContext
  a rdf:Property, owl:ObjectProperty ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "manageable Context"@en ;
  rdfs:domain sd:GraphCollection ;
  rdfs:range sd:NamedGraph ;
  rdfs:comment "Links a registry catalogue to a Context for which the requesting client has effective manage permission under the applicable Context contract. This is a response-relative summary, not a stored policy or a transferable capability. Later operations require current authorization."@en .


##
## SPARQL service description — features a service can refuse
##
## A service description (SPS-SPARQL-021) links the service to each catalogued feature it refuses
## for the requesting client. The individuals after the property name SPARQL 1.1 Query features
## neutrally, so that a refusal has the same name everywhere. Naming a feature grants no permission
## to refuse it, and this file never says which features a service refuses. SERVICE is named by the
## standard individual sd:BasicFederatedQuery and is not repeated here.
##

sps:unsupportedFeature
  a rdf:Property, owl:ObjectProperty ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "unsupported feature"@en ;
  rdfs:domain sd:Service ;
  rdfs:range sd:Feature ;
  rdfs:comment "Links a SPARQL service to a feature it refuses in a query from the requesting client. This is a response-relative summary, not a stored policy or a transferable capability. Which features a service refuses is stated only in its description, never in this vocabulary."@en .

sps:Union
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "union"@en ;
  rdfs:comment "A group graph pattern that combines alternatives with UNION."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#alternatives> .

sps:AlternativePath
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "alternative path"@en ;
  rdfs:comment "A property path with an alternative, written a|b."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#pp-language> .

sps:Minus
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "MINUS"@en ;
  rdfs:comment "A graph pattern that removes solutions with MINUS."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#neg-minus> .

sps:Exists
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "EXISTS"@en ;
  rdfs:comment "A filter that tests a pattern with EXISTS or NOT EXISTS."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#neg-pattern> .

sps:InlineData
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "inline data"@en ;
  rdfs:comment "Inline data supplied with VALUES, inside a pattern or after the query."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#inline-data> .

sps:ArbitraryLengthPath
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "arbitrary-length path"@en ;
  rdfs:comment "A property path with * or +, matching paths of any length."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#pp-language> .

sps:ZeroOrOnePath
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "zero-or-one path"@en ;
  rdfs:comment "A property path with ?, matching a path of length zero or one."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#pp-language> .

sps:Aggregation
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "aggregation"@en ;
  rdfs:comment "Grouping and aggregation: GROUP BY, HAVING or an aggregate function such as COUNT."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#aggregates> .

sps:Subquery
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "subquery"@en ;
  rdfs:comment "A SELECT query nested inside a graph pattern."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#subqueries> .

sps:NamedGraphPattern
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "named graph pattern"@en ;
  rdfs:comment "A graph pattern scoped to named graphs with the GRAPH keyword."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#queryDataset> .

sps:AskQuery
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "ASK query"@en ;
  rdfs:comment "The ASK query form."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#ask> .

sps:ConstructQuery
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "CONSTRUCT query"@en ;
  rdfs:comment "The CONSTRUCT query form."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#construct> .

sps:DescribeQuery
  a sd:Feature ;
  rdfs:isDefinedBy <https://schema.sempods.org/> ;
  rdfs:label "DESCRIBE query"@en ;
  rdfs:comment "The DESCRIBE query form."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/2013/REC-sparql11-query-20130321/#describe> .
